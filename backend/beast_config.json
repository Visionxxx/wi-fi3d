{
  "timestep_seconds": 2,
  "freshness_seconds": 25,
  "grace_seconds": 90,
  "max_active_sources": 80,
  "smoothing": {
    "ewma_alpha": 0.35,
    "median_window": 3,
    "wifi": {
      "ewma_alpha": 0.35,
      "median_window": 3
    },
    "bluetooth": {
      "ewma_alpha": 0.2,
      "median_window": 5
    }
  },
  "scoring": {
    "min_samples": 20,
    "max_lag": 3,
    "add_threshold": 0.62,
    "remove_threshold": 0.45,
    "top_k_per_node": 6,
    "co_visibility_weight": 0.2,
    "correlation_weight": 0.55,
    "cross_corr_weight": 0.25
  },
  "zones": {
    "edge_confidence_threshold": 0.55,
    "stability_lock_ticks": 3
  },
  "change_detection": {
    "drift_window": 20,
    "moved_neighbor_overlap_threshold": 0.4
  },
  "validation": {
    "zone_purity_min": 0.72,
    "zone_coverage_min": 0.75,
    "floor_consistency_min": 0.72,
    "stable_node_recall_min": 0.8,
    "avg_edge_churn_max": 0.35
  },
  "logging": {
    "enabled": true,
    "path": "backend/replay/live_capture.ndjson"
  }
}
